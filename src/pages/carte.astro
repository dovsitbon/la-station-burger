---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import MenuList from '../components/MenuList.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { menu } from '../data/menu';
import { site } from '../data/site';
import { menuSchema } from '../lib/schema';

const base = Astro.site ?? new URL(site.url);
---

<BaseLayout
  title="Carte & prix : burgers, steakhouse, hot-dogs"
  description="Carte et prix de La Station Burger à Deuil-la-Barre : burgers dès 8,90 €, menus avec frites maison, steakhouse, hot-dogs, bagels, salades et desserts."
  breadcrumb={[{ name: 'La carte', path: '/carte/' }]}
  schema={[menuSchema(base)]}
>
  <PageHeader
    eyebrow={`Carte ${site.menuUpdated}`}
    title="La carte & les prix"
    lead="Prix sur place et à emporter. Les menus comprennent des frites fraîches maison et une boisson classique (33 cl)."
  >
    <div class="btn-row">
      <a class="btn btn--primary" href="/commander/"><Icon name="bag" /> Commander</a>
      <a class="btn" href={site.menuPdfUrl} target="_blank" rel="noopener">Carte imprimable (PDF) <Icon name="external" /></a>
    </div>
  </PageHeader>

  <nav class="cat-nav" aria-label="Catégories de la carte">
    <div class="container">
      <ul role="list">
        {
          menu.map((c) => (
            <li>
              <a href={`#${c.id}`}>{c.title}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="container menu-body">
    {
      menu.map((cat) => (
        <section class:list={['cat', cat.image && 'cat--with-image', cat.id === 'signature' && 'cat--signature']} id={cat.id} aria-labelledby={`${cat.id}-title`}>
          <div class="cat__head">
            <h2 id={`${cat.id}-title`}>{cat.title}</h2>
            {cat.intro && <p class="cat__intro">{cat.intro}</p>}
            {cat.menuNote && <p class="cat__note">{cat.menuNote}</p>}
            {cat.image && (
              <Photo name={cat.image} sizes="(min-width: 960px) 30vw, 92vw" ratio="4 / 3" widths={[480, 800, 1100]} class="cat__photo" />
            )}
          </div>
          <div class="cat__items">
            <MenuList items={cat.items} withMenuPrice={Boolean(cat.menuNote)} />
            {cat.footnote && <p class="cat__footnote">{cat.footnote}</p>}
            {cat.id === 'signature' && (
              <a class="text-link" href="/tissot-de-la-varenne/">
                L’histoire du burger primé
              </a>
            )}
          </div>
        </section>
      ))
    }

    <aside class="menu-notes">
      <h2 class="visually-hidden">Informations sur la carte</h2>
      <p>Prix TTC en euros, service compris, d’après la carte {site.menuUpdated} du restaurant. Les prix sur Uber Eats et Deliveroo sont fixés par les plateformes et peuvent différer.</p>
      <p>Pour toute question sur les allergènes ou la composition d’un plat, interrogez l’équipe au {site.phone.display}.</p>
      <p>{site.payment.join(' et ')} acceptés. {site.paymentNote}</p>
    </aside>
  </div>
</BaseLayout>

<style>
  .cat-nav {
    position: sticky;
    top: var(--header-h);
    z-index: 30;
    background: rgba(15, 13, 11, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .cat-nav ul {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    padding: 0.7rem 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, #000 92%, transparent);
  }
  .cat-nav ul::-webkit-scrollbar {
    display: none;
  }
  .cat-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    color: var(--cream-muted);
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }
  .cat-nav a:hover {
    color: var(--cream);
    border-color: var(--cream);
  }
  .cat-nav a.is-active {
    background: var(--copper);
    border-color: var(--copper);
    color: var(--on-copper);
  }

  .menu-body {
    padding-block: 1rem 5rem;
  }
  .cat {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 64px);
  }
  .cat__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cat__intro {
    color: var(--cream-muted);
  }
  .cat__note {
    font-size: 0.88rem;
    color: var(--copper);
    font-weight: 600;
  }
  .cat__head :global(.cat__photo) {
    display: none;
    margin-top: 0.75rem;
  }
  .cat__footnote {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--copper);
    background: var(--ink-2);
    color: var(--cream-muted);
    font-size: 0.95rem;
  }
  .cat__items .text-link {
    display: inline-block;
    margin-top: 1.25rem;
  }
  .cat--signature {
    border: 1px solid rgba(207, 138, 80, 0.45);
    border-radius: var(--radius-lg);
    padding-inline: clamp(1.25rem, 3vw, 2.5rem);
    margin-top: 2rem;
    background: linear-gradient(160deg, rgba(207, 138, 80, 0.08), transparent 60%);
  }
  .menu-notes {
    display: grid;
    gap: 0.75rem;
    margin-top: 3rem;
    color: var(--cream-muted);
    font-size: 0.92rem;
    max-width: 70ch;
  }
  @media (min-width: 960px) {
    .cat {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 4rem;
    }
    .cat__head {
      position: sticky;
      top: calc(var(--header-h) + 90px);
      align-self: start;
    }
    .cat__head :global(.cat__photo) {
      display: block;
    }
  }
</style>

<script>
  // Surligne la catégorie visible dans la barre de navigation.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.cat-nav a').forEach((a) => links.set(a.hash.slice(1), a));
  let current: HTMLAnchorElement | undefined;
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const link = links.get(e.target.id);
        if (!link || link === current) continue;
        current?.classList.remove('is-active');
        current?.removeAttribute('aria-current');
        link.classList.add('is-active');
        link.setAttribute('aria-current', 'location');
        link.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
        current = link;
      }
    },
    { rootMargin: '-35% 0px -60% 0px' },
  );
  document.querySelectorAll('.cat').forEach((s) => io.observe(s));
</script>
