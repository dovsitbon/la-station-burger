---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { gallery, photo } from '../data/images';
import { site } from '../data/site';

const items = await Promise.all(
  gallery.map(async (key) => {
    const p = photo(key);
    const full = await getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'webp', quality: 75 });
    return { key, ...p, full: full.src };
  }),
);
const anyPlaceholder = items.some((i) => i.placeholder);
---

<BaseLayout
  title="Galerie photo"
  description="Galerie de La Station Burger à Deuil-la-Barre : burgers gourmets, steakhouse, frites maison, desserts et milkshakes."
  breadcrumb={[{ name: 'Galerie', path: '/galerie/' }]}
>
  <PageHeader
    eyebrow="Galerie"
    title="Ça se passe à La Station"
    lead={anyPlaceholder
      ? "Les photos ci-dessous sont des illustrations provisoires (licence Unsplash) : elles seront remplacées par les photos du restaurant et de ses plats."
      : 'Burgers, steakhouse, frites maison et desserts de la maison.'}
  >
    <div class="btn-row">
      <a class="btn" href={site.social.instagram.url} target="_blank" rel="noopener"><Icon name="instagram" /> Suivre {site.social.instagram.handle}</a>
    </div>
  </PageHeader>

  <section class="section">
    <div class="container">
      <ul class="masonry" role="list">
        {
          items.map((it, i) => (
            <li data-reveal style={`--i:${i % 4}`}>
              <a class="tile" href={it.full} data-lightbox data-alt={it.alt} data-placeholder={it.placeholder ? '1' : undefined}>
                <Image
                  src={it.src}
                  alt={it.alt}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 1000px) 30vw, (min-width: 600px) 46vw, 92vw"
                  format="webp"
                  quality={70}
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
                {it.placeholder && <span class="placeholder-tag">Photo d’illustration</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <dialog class="lightbox" aria-label="Photo agrandie" data-lightbox-dialog>
    <button type="button" class="lightbox__close" data-lightbox-close>
      <Icon name="close" /><span class="visually-hidden">Fermer</span>
    </button>
    <figure>
      <img alt="" data-lightbox-img />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
  </dialog>
</BaseLayout>

<style>
  .masonry {
    columns: 1;
    column-gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .masonry li {
    break-inside: avoid;
    margin-bottom: 1rem;
  }
  .tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--ink-3);
  }
  .tile :global(img) {
    width: 100%;
    transition: transform 600ms var(--ease-out);
  }
  .tile:hover :global(img) {
    transform: scale(1.03);
  }
  .lightbox {
    overscroll-behavior: contain;
    width: min(96vw, 1200px);
    max-height: 92vh;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--ink);
    color: var(--cream);
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }
  .lightbox figure {
    margin: 0;
  }
  .lightbox img {
    width: 100%;
    max-height: 82vh;
    object-fit: contain;
  }
  .lightbox figcaption {
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    color: var(--cream-muted);
  }
  .lightbox__close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius);
    background: rgba(15, 13, 11, 0.8);
    color: var(--cream);
    cursor: pointer;
  }
  .lightbox__close :global(svg) {
    width: 22px;
    height: 22px;
  }
  @media (min-width: 600px) {
    .masonry {
      columns: 2;
    }
  }
  @media (min-width: 1000px) {
    .masonry {
      columns: 3;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const img = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const caption = document.querySelector<HTMLElement>('[data-lightbox-caption]');
  if (dialog && img && caption && typeof dialog.showModal === 'function') {
    document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        img.src = a.href;
        img.alt = a.dataset.alt || '';
        caption.textContent = (a.dataset.alt || '') + (a.dataset.placeholder ? ' — photo d’illustration' : '');
        dialog.showModal();
      });
    });
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
