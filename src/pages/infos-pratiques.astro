---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import MapFacade from '../components/MapFacade.astro';
import { site, fullAddress, telHref, mapsDirectionsUrl, activeOrdering, groupedHours } from '../data/site';
import { menu } from '../data/menu';
import { faqSchema } from '../lib/schema';

const fmt = (t: string) => t.replace(':00', 'h').replace(':', 'h');
const sunday = site.hours.find((h) => h.day === 0)!;
const veggie = menu
  .flatMap((c) => c.items)
  .filter((i) => i.tags?.includes('veggie'))
  .map((i) => i.name);

const hoursText = groupedHours()
  .map((g) => `${g.days} : ${g.time}`)
  .join(' ; ');

const faqs = [
  { q: 'Quels sont les horaires de La Station Burger ?', a: `${hoursText}.` },
  {
    q: 'La Station Burger est-elle ouverte le dimanche ?',
    a: `Oui, le dimanche soir de ${fmt(sunday.open)} à ${fmt(sunday.close)}.`,
  },
  {
    q: 'Peut-on se faire livrer ?',
    a: `Oui, via ${activeOrdering.map((o) => o.label).join(' et ')}, selon les zones desservies par ces plateformes.`,
  },
  {
    q: 'Peut-on commander à emporter ?',
    a: `Oui : appelez le ${site.phone.display} et récupérez votre commande au 41 rue de la Gare.`,
  },
  {
    q: 'Quels moyens de paiement sont acceptés ?',
    a: `${site.payment.join(' et ')}. ${site.paymentNote}`,
  },
  {
    q: 'Y a-t-il des options végétariennes ?',
    a: `Oui : ${veggie.join(', ')}. Pour les allergènes, renseignez-vous auprès de l’équipe.`,
  },
  ...(site.halalMention
    ? [
        {
          q: 'La viande est-elle halal ?',
          a: "Le restaurant affiche la mention halal sur son compte Instagram officiel. Pour le détail par produit, renseignez-vous directement auprès de l’équipe.",
        },
      ]
    : []),
  { q: 'Comment venir en transports en commun ?', a: site.access.train },
  {
    q: 'Peut-on venir en groupe ?',
    a: `Pour une table à plusieurs, appelez le restaurant au ${site.phone.display} avant de venir.`,
  },
];
---

<BaseLayout
  title="Horaires, adresse & accès — Deuil-la-Barre"
  description={`La Station Burger, ${fullAddress}. Horaires : ${hoursText}. Tél. ${site.phone.display}. Accès ligne H.`}
  breadcrumb={[{ name: 'Infos pratiques', path: '/infos-pratiques/' }]}
  schema={[faqSchema(faqs)]}
>
  <PageHeader eyebrow="Infos pratiques" title="Horaires, adresse & accès">
    <OpenStatus />
  </PageHeader>

  <section class="section">
    <div class="container info-grid">
      <article class="card" data-reveal>
        <h2 class="card__title"><Icon name="clock" /> Horaires</h2>
        <table class="hours-table">
          <caption class="visually-hidden">Horaires d’ouverture</caption>
          <tbody>
            {
              site.hours.map((h) => (
                <tr data-day={h.day}>
                  <th scope="row">{h.label}</th>
                  <td>
                    {fmt(h.open)} – {fmt(h.close)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="card__fine">Horaires publiés par le restaurant. Ils peuvent varier les jours fériés : en cas de doute, appelez.</p>
      </article>

      <article class="card" data-reveal style="--i:1">
        <h2 class="card__title"><Icon name="pin" /> Adresse</h2>
        <address>
          <strong>{site.name}</strong><br />
          {site.address.street}<br />
          {site.address.postalCode} {site.address.city}
        </address>
        <p class="card__row"><Icon name="train" /> {site.access.train}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={mapsDirectionsUrl} target="_blank" rel="noopener">Itinéraire <Icon name="external" /></a>
        </div>
      </article>

      <article class="card" data-reveal style="--i:2">
        <h2 class="card__title"><Icon name="phone" /> Contact</h2>
        <p><a class="big-link" href={telHref}>{site.phone.display}</a></p>
        <p><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></p>
        <ul class="socials-inline" role="list">
          <li><a href={site.social.instagram.url} target="_blank" rel="noopener"><Icon name="instagram" /> {site.social.instagram.handle}</a></li>
          <li><a href={site.social.facebook.url} target="_blank" rel="noopener"><Icon name="facebook" /> {site.social.facebook.handle}</a></li>
        </ul>
      </article>

      <article class="card" data-reveal style="--i:3">
        <h2 class="card__title"><Icon name="card" /> Services & paiement</h2>
        <ul class="checks" role="list">
          <li><Icon name="check" /> Sur place</li>
          <li><Icon name="check" /> À emporter (commande par téléphone)</li>
          <li><Icon name="check" /> Livraison : {activeOrdering.map((o) => o.label).join(', ')}</li>
          {site.payment.map((p) => <li><Icon name="check" /> {p}</li>)}
        </ul>
        <p class="card__fine">{site.paymentNote}</p>
      </article>
    </div>
  </section>

  <section class="section section--raised">
    <div class="container">
      <h2 class="visually-hidden">Plan d’accès</h2>
      <MapFacade />
    </div>
  </section>

  <section class="section">
    <div class="container faq faq-layout">
      <h2>Questions fréquentes</h2>
      <div>
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .info-grid {
    display: grid;
    gap: 1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--ink-2);
  }
  .card__title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.5rem;
  }
  .card__title :global(svg) {
    width: 24px;
    height: 24px;
    color: var(--copper);
  }
  .card__fine {
    font-size: 0.85rem;
    color: var(--cream-muted);
  }
  .card__row {
    display: flex;
    gap: 0.6rem;
    color: var(--cream-muted);
  }
  .card__row :global(svg) {
    width: 20px;
    height: 20px;
    flex: none;
    color: var(--copper);
    margin-top: 0.2rem;
  }
  address {
    font-style: normal;
    font-size: 1.1rem;
  }
  .hours-table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .hours-table th,
  .hours-table td {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .hours-table th {
    font-weight: 500;
    color: var(--cream-muted);
  }
  .hours-table td {
    text-align: right;
    font-weight: 700;
  }
  .hours-table tr.is-today th,
  .hours-table tr.is-today td {
    color: var(--copper);
  }
  .big-link {
    font-family: var(--font-display);
    font-size: 1.8rem;
    text-decoration: none;
  }
  .socials-inline,
  .checks {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .socials-inline a,
  .checks li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .socials-inline a {
    min-height: 44px;
  }
  .socials-inline :global(svg),
  .checks :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--copper);
    flex: none;
  }
  .faq-layout {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 760px) {
    .info-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 960px) {
    .faq-layout {
      grid-template-columns: 1fr 2fr;
      gap: 4rem;
    }
  }
</style>

<script>
  const day = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Paris', weekday: 'short' }).format(new Date());
  const idx = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(day);
  document.querySelector(`.hours-table tr[data-day="${idx}"]`)?.classList.add('is-today');
</script>
