---
import Icon from './Icon.astro';
import { formatPrice, tagLabels, type MenuItem } from '../data/menu';

interface Props {
  items: MenuItem[];
  /** Affiche les colonnes « Seul / Menu ». */
  withMenuPrice?: boolean;
  /** Affiche les mentions « à confirmer » (désactiver en production si souhaité). */
  showConfirm?: boolean;
}
const { items, withMenuPrice = false, showConfirm = true } = Astro.props;
const tagIcon = { spicy: 'flame', veggie: 'leaf', signature: 'medal' } as const;
---

<ul class="menu-list" role="list">
  {
    items.map((item) => (
      <li class="menu-item">
        <div class="menu-item__head">
          <h3 class="menu-item__name">{item.name}</h3>
          <span class="menu-item__leader" aria-hidden="true" />
          <p class="menu-item__prices">
            {item.price !== undefined && (
              <span class="price">
                {withMenuPrice && item.menuPrice !== undefined && <span class="price__label">Seul</span>}
                {formatPrice(item.price)}
              </span>
            )}
            {withMenuPrice && item.menuPrice !== undefined && (
              <span class="price price--menu">
                <span class="price__label">Menu</span>
                {formatPrice(item.menuPrice)}
              </span>
            )}
          </p>
        </div>
        {item.description && <p class="menu-item__desc">{item.description}</p>}
        {(item.tags?.length || (showConfirm && item.confirm)) && (
          <p class="menu-item__tags">
            {item.tags?.map((t) => (
              <span class={`tag tag--${t}`}>
                {t in tagIcon && <Icon name={tagIcon[t as keyof typeof tagIcon]} />}
                {tagLabels[t]}
              </span>
            ))}
            {showConfirm && item.confirm && (
              <span class="tag tag--confirm" title={item.confirm}>
                À confirmer
              </span>
            )}
          </p>
        )}
      </li>
    ))
  }
</ul>

<style>
  .menu-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-item {
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--line);
  }
  .menu-item:first-child {
    padding-top: 0.25rem;
  }
  .menu-item__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .menu-item__name {
    font-family: var(--font-body);
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }
  .menu-item__leader {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted var(--line-strong);
    transform: translateY(-0.3em);
  }
  .menu-item__prices {
    display: flex;
    gap: 1rem;
    flex: none;
    font-variant-numeric: tabular-nums;
  }
  .price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }
  .price--menu {
    color: var(--copper);
  }
  .price__label {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cream-muted);
  }
  .menu-item__desc {
    margin-top: 0.35rem;
    color: var(--cream-muted);
    font-size: 0.97rem;
    max-width: 62ch;
  }
  .menu-item__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cream-muted);
  }
  .tag :global(svg) {
    width: 13px;
    height: 13px;
  }
  .tag--spicy {
    color: #e8967a;
    border-color: rgba(232, 150, 122, 0.4);
  }
  .tag--veggie {
    color: #9fcb8f;
    border-color: rgba(159, 203, 143, 0.4);
  }
  .tag--signature {
    color: var(--copper);
    border-color: rgba(207, 138, 80, 0.5);
  }
  .tag--confirm {
    border-style: dashed;
    cursor: help;
  }
</style>
