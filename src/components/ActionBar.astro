---
import Icon from './Icon.astro';
import { telHref, mapsDirectionsUrl } from '../data/site';
---

<nav class="action-bar" aria-label="Actions rapides">
  <a href={telHref}><Icon name="phone" /><span>Appeler</span></a>
  <a href={mapsDirectionsUrl} target="_blank" rel="noopener"><Icon name="pin" /><span>Itinéraire</span></a>
  <a href="/carte/"><Icon name="book" /><span>La carte</span></a>
  <a href="/commander/" class="is-primary"><Icon name="bag" /><span>Commander</span></a>
</nav>

<style>
  .action-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--line);
    border-top: 1px solid var(--line-strong);
  }
  .action-bar a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    min-height: var(--actionbar-h);
    background: rgba(23, 19, 15, 0.97);
    color: var(--cream);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
  }
  .action-bar a :global(svg) {
    width: 22px;
    height: 22px;
  }
  .action-bar a.is-primary {
    background: var(--copper);
    color: var(--on-copper);
  }
  .action-bar a:active {
    filter: brightness(1.15);
  }
  @media (min-width: 900px) {
    .action-bar {
      display: none;
    }
  }
</style>
